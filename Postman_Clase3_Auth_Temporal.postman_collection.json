{
  "info": {
    "_postman_id": "7c0b2d4c-9e62-4f0d-8a6f-4a2a4f2e9b11",
    "name": "Clase 3 - Autenticacion Temporal",
    "description": "Coleccion simple para la actividad de autenticacion temporal con Bearer Base64, roles ADMIN/USER y endpoint protegido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const token = pm.response.text();",
                  "    pm.collectionVariables.set('authToken', token);",
                  "    console.log('Token guardado: ' + token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login/admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login",
                "admin"
              ]
            },
            "description": "Genera un token Base64 para el rol ADMIN.\n\nNota: El token se guarda automáticamente en la variable authToken."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const token = pm.response.text();",
                  "    pm.collectionVariables.set('authToken', token);",
                  "    console.log('Token guardado: ' + token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login",
                "user"
              ]
            },
            "description": "Genera un token Base64 para el rol USER.\n\nNota: El token se guarda automáticamente en la variable authToken."
          }
        }
      ]
    },
    {
      "name": "Protegidos",
      "item": [
        {
          "name": "GET Productos Protegidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "Debe responder 401 sin token, 403 con token USER y 200 con token ADMIN."
          }
        },
        {
          "name": "GET Resumen Portal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/portal/resumen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "portal",
                "resumen"
              ]
            },
            "description": "Prueba el flujo BFF -> Gateway reenviando Authorization."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ]
}

