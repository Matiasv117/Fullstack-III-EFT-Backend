{
  "family": "bff",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": 512,
  "memory": 1024,
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "bff",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/bff:latest",
      "portMappings": [
        {
          "containerPort": 8097,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "EUREKA_CLIENT_SERVICE-URL_DEFAULTZONE", "value": "http://eureka-server:8761/eureka/" },
        { "name": "JWT_SECRET", "value": "miClaveSecretaSuperSeguraParaJWT2024SaludRedNorte" },
        { "name": "BFF_AUTH_BASE_URL", "value": "lb://ms-auth" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bff",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8097/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
