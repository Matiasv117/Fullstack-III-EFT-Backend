{
  "family": "rabbitmq",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": 512,
  "memory": 1024,
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "rabbitmq",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/rabbitmq:latest",
      "portMappings": [
        {
          "containerPort": 5672,
          "protocol": "tcp"
        },
        {
          "containerPort": 15672,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rabbitmq",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "rabbitmq-diagnostics -q ping || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
