# Copia este archivo a: config/local-insforge.env
# (local-insforge.env está en .gitignore — no subas contraseñas a GitHub)
#
# En Insforge: usa "Connection String" / parámetros individuales.
# La opción "Copy Prompt" es solo para pegar en un chat de IA, NO hace falta para tu app.
#
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://avfg5eh3.us-east.database.insforge.app:5432/insforge?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=PEGA_AQUI_LA_PASSWORD_DEL_PANEL_SHOW_PASSWORD
