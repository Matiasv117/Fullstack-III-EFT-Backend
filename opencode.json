{
  "$schema": "https://opencode.ai/schema/opencode.json",
  "description": "InsForge (RedNorte) - Fullstack Healthcare Platform",
  "customCommands": [
    {
      "name": "frontend:dev",
      "description": "Iniciar servidor de desarrollo frontend",
      "command": "npm run dev",
      "workdir": "Fullstack-III-EFT-Frontend"
    },
    {
      "name": "frontend:test",
      "description": "Correr tests del frontend",
      "command": "npm test",
      "workdir": "Fullstack-III-EFT-Frontend"
    },
    {
      "name": "frontend:test:watch",
      "description": "Tests en modo watch",
      "command": "npm test -- --watch",
      "workdir": "Fullstack-III-EFT-Frontend"
    },
    {
      "name": "frontend:lint",
      "description": "Ejecutar ESLint",
      "command": "npm run lint",
      "workdir": "Fullstack-III-EFT-Frontend"
    },
    {
      "name": "frontend:build",
      "description": "Build de producción",
      "command": "npm run build",
      "workdir": "Fullstack-III-EFT-Frontend"
    },
    {
      "name": "eureka:start",
      "description": "Iniciar eureka-server",
      "command": "./mvnw spring-boot:run",
      "workdir": "eureka-server"
    },
    {
      "name": "gateway:start",
      "description": "Iniciar api-gateway",
      "command": "./mvnw spring-boot:run",
      "workdir": "api-gateway"
    },
    {
      "name": "bff:start",
      "description": "Iniciar bff (salud-bff)",
      "command": "./mvnw spring-boot:run",
      "workdir": "bff"
    },
    {
      "name": "ms-auth:start",
      "description": "Iniciar ms-auth",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-auth"
    },
    {
      "name": "ms-auth:test",
      "description": "Tests de ms-auth",
      "command": "./mvnw test",
      "workdir": "ms-auth"
    },
    {
      "name": "ms-gestionpacientes:start",
      "description": "Iniciar ms-gestionpacientes",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-gestionpacientes"
    },
    {
      "name": "ms-gestionpacientes:test",
      "description": "Tests de ms-gestionpacientes",
      "command": "./mvnw test",
      "workdir": "ms-gestionpacientes"
    },
    {
      "name": "ms-optimizacion:start",
      "description": "Iniciar ms-optimizacion",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-optimizacion"
    },
    {
      "name": "ms-optimizacion:test",
      "description": "Tests de ms-optimizacion",
      "command": "./mvnw test",
      "workdir": "ms-optimizacion"
    },
    {
      "name": "ms-notificaciones:start",
      "description": "Iniciar ms-notificaciones",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-notificaciones"
    },
    {
      "name": "ms-notificaciones:test",
      "description": "Tests de ms-notificaciones",
      "command": "./mvnw test",
      "workdir": "ms-notificaciones"
    },
    {
      "name": "ms-progreso:start",
      "description": "Iniciar ms-progreso",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-progreso"
    },
    {
      "name": "ms-progreso:test",
      "description": "Tests de ms-progreso",
      "command": "./mvnw test",
      "workdir": "ms-progreso"
    },
    {
      "name": "ms-auditoria:start",
      "description": "Iniciar ms-auditoria",
      "command": "./mvnw spring-boot:run",
      "workdir": "ms-auditoria"
    },
    {
      "name": "ms-auditoria:test",
      "description": "Tests de ms-auditoria",
      "command": "./mvnw test",
      "workdir": "ms-auditoria"
    },
    {
      "name": "project:start-all",
      "description": "Iniciar todos los servicios con Docker",
      "command": "scripts/start-all.ps1"
    },
    {
      "name": "project:start-no-docker",
      "description": "Iniciar servicios sin Docker",
      "command": "scripts/start-no-docker.ps1"
    },
    {
      "name": "project:stop-all",
      "description": "Detener todos los servicios",
      "command": "scripts/stop-all.ps1"
    },
    {
      "name": "project:smoke-test",
      "description": "Smoke test E2E",
      "command": "scripts/smoke-test-e2e.ps1"
    }
  ],
  "rules": [
    {
      "description": "No modificar archivos .md sin preguntar",
      "glob": "*.md"
    },
    {
      "description": "No modificar node_modules",
      "glob": "**/node_modules/**"
    }
  ],
  "agentInstructions": "Leer AGENTS.md al inicio de cada sesión para contexto completo del proyecto. Archivos .md de documentación pueden estar desactualizados; priorizar código fuente y AGENTS.md.",
  "mcp": {
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    }
  }
}
