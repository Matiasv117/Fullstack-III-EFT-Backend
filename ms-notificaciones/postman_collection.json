{
  "info": {
    "name": "Microservicio Notificaciones - Pruebas",
    "description": "Colección para probar los endpoints del microservicio de notificaciones (rutas en español)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear Notificación",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pacienteId\": 1, \"tipo\": \"CITA_CONFIRMADA\", \"mensaje\": \"Su cita médica ha sido confirmada para mañana a las 10:00 AM.\"}"
        },
        "url": {
          "raw": "http://localhost:8085/api/notificaciones",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones"]
        }
      }
    },
    {
      "name": "Obtener Notificaciones Pendientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/pendientes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "pendientes"]
        }
      }
    },
    {
      "name": "Obtener Notificación por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/{{notificationId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "{{notificationId}}"]
        }
      }
    },
    {
      "name": "Obtener Notificaciones por Paciente ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/paciente/{{pacienteId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "paciente", "{{pacienteId}}"]
        }
      }
    },
    {
      "name": "Enviar Notificación por ID",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/{{notificationId}}/enviar",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "{{notificationId}}", "enviar"]
        }
      }
    },
    {
      "name": "Enviar Notificación por Canal",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/{{notificationId}}/enviar-canal?canal={{canal}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "{{notificationId}}", "enviar-canal"],
          "query": [
            {
              "key": "canal",
              "value": "{{canal}}"
            }
          ]
        }
      }
    },
    {
      "name": "Enviar Todas las Notificaciones Pendientes",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/enviar-todas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "enviar-todas"]
        }
      }
    },
    {
      "name": "Obtener Canales Disponibles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8085/api/notificaciones/info/canales",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "notificaciones", "info", "canales"]
        }
      }
    },
    {
