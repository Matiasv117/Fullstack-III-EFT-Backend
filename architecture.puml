@startuml InsForge-RedNorte-Architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

skinparam rectangle {
  BackgroundColor<<cloud>> #E8F4FD
  BorderColor<<cloud>> #2196F3
  BackgroundColor<<frontend>> #FFF3E0
  BorderColor<<frontend>> #FF9800
  BackgroundColor<<gateway>> #F3E5F5
  BorderColor<<gateway>> #9C27B0
  BackgroundColor<<backend>> #E8F5E9
  BorderColor<<backend>> #4CAF50
  BackgroundColor<<database>> #FFEBEE
  BorderColor<<database>> #F44336
  BackgroundColor<<infra>> #ECEFF1
  BorderColor<<infra>> #607D8B
}

title InsForge RedNorte - Arquitectura AWS EKS

rectangle "Internet" as internet <<cloud>> #E3F2FD

rectangle "AWS VPC (us-east-1)" as vpc <<infra>> {

  rectangle "NLB Frontend\n:80" as nlb_fe <<infra>>
  rectangle "NLB API Gateway\n:8080" as nlb_gw <<infra>>

  rectangle "Frontend\nReact 19 + Vite + Tailwind\nNginx (:80)" as frontend <<frontend>>

  rectangle "API Gateway\nSpring Cloud Gateway\nNetty (:8080)" as gateway <<gateway>>

  rectangle "MS Auth\nSpring Boot (:8087)\nJWT, Registro, Roles" as auth <<backend>>
  rectangle "MS GestionPacientes\nSpring Boot (:8083)\nPacientes, Lista Espera" as gp <<backend>>
  rectangle "MS Optimizacion\nSpring Boot (:8084)\nCitas, Medicos, Horarios" as opt <<backend>>
  rectangle "MS Notificaciones\nSpring Boot (:8085)\nEmail, Push" as notif <<backend>>

  rectangle "Neon PostgreSQL\n(Shared instance)\nFlyway migrations" as db <<database>>
}

rectangle "ECR" as ecr <<infra>> {
  rectangle "api-gateway:latest" as ecr_gw
  rectangle "ms-auth:latest" as ecr_auth
  rectangle "ms-gestionpacientes:latest" as ecr_gp
  rectangle "ms-optimizacion:latest" as ecr_opt
  rectangle "ms-notificaciones:latest" as ecr_notif
  rectangle "frontend:latest" as ecr_fe
}

rectangle "GitHub Actions\nCI/CD Pipeline" as ci <<infra>> {
  rectangle "Build & Test" as ci_test
  rectangle "Docker Build" as ci_build
  rectangle "Push ECR" as ci_push
  rectangle "Deploy EKS" as ci_deploy
}

' --- Conexiones externas ---
internet -down-> nlb_fe
internet -down-> nlb_gw

' --- NLB a pods ---
nlb_fe -down-> frontend
nlb_gw -down-> gateway

' --- Frontend a Gateway ---
frontend -right-> gateway : /api/**

' --- Gateway a Microservicios ---
gateway -down-> auth : /api/auth/**
gateway -down-> gp : /api/pacientes/**\n/api/lista-espera/**
gateway -down-> opt : /api/optimizacion/**\n/api/citas/**\n/api/medicos/**
gateway -down-> notif : /api/notificaciones/**

' --- Feign clients (comunicacion directa entre MS) ---
auth -right-> gp : Feign\nPacienteClient
gp -right-> opt : Feign\nCitaClient
gp -right-> notif : Feign\nNotificationClient
opt -left-> gp : Feign\nPacienteClient\nListaEsperaClient
opt -right-> notif : Feign\nNotificationClient

' --- Base de datos ---
auth -down-> db
gp -down-> db
opt -down-> db
notif -down-> db

' --- CI/CD ---
ci_test -right-> ci_build
ci_build -right-> ci_push
ci_push -right-> ci_deploy
ci_deploy .down.> ecr : push images
ci_deploy .down.> gateway : kubectl apply

legend right
  | Color | Capa |
  | <#E8F4FD> | Cloud / Internet |
  | <#FFF3E0> | Frontend |
  | <#F3E5F5> | API Gateway |
  | <#E8F5E9> | Microservicios |
  | <#FFEBEE> | Base de Datos |
  | <#ECEFF1> | Infraestructura AWS |
endlegend

@enduml
